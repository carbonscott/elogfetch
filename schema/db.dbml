// elogfetch Database Schema (Revised)
// Render at https://dbdiagram.io

// =============================================================================
// Independent lookup / reference tables
// =============================================================================

Table user {
  id text [pk, note: 'Linux username, e.g. "swelborn"']
}

Table posix_group {
  name text [pk, note: 'e.g. "ps-xpp", "ps-mfx"']
}

Table detector {
  id text [pk, note: 'e.g. "DAQ Detectors/Rayonix"']
  name text [unique, not null]
  description text
}

Table metadata {
  key text [pk]
  value text
}

// =============================================================================
// PI extends user with contact info
// =============================================================================

Table pi {
  id text [pk, note: 'FK to user.id']
  name text [not null]
  email text [not null]
}

// =============================================================================
// Junction: users <-> posix_groups (many-to-many)
// =============================================================================

Table user_posix_group {
  user_id text [not null]
  posix_group_name text [not null]

  indexes {
    (user_id, posix_group_name) [pk]
  }
}

// =============================================================================
// Experiment (central entity)
// =============================================================================

Table experiment {
  experiment_id text [pk]
  name text [not null]
  instrument text [not null]
  start_time timestamptz [not null]
  end_time timestamptz [not null]
  pi_id text [not null, note: 'Single PI per experiment']
  leader_account text [not null]
  posix_group text [not null, note: 'One posix group per experiment']
  description text
}

Table experiment_slack_channel {
  experiment_id text [pk, note: 'At most one channel per experiment']
  channel text [not null, note: 'e.g. "#xpp-elog"']
}

Table experiment_analysis_queue {
  experiment_id text [not null, note: 'Space-separated in source, normalized here']
  queue text [not null, note: 'e.g. "ffbh2q"']

  indexes {
    (experiment_id, queue) [pk]
  }
}

// =============================================================================
// Questionnaire fields (per experiment)
// =============================================================================

Table questionnaire {
  questionnaire_id bigserial [pk]
  experiment_id text [not null]
  proposal text
  category text [not null]
  field_id text [not null]
  field_name text
  field_value text
  modified_time timestamptz
  modified_uid text
  created_time timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (experiment_id, field_id) [unique]
    experiment_id
    category
  }
}

// =============================================================================
// Workflow definitions (templates, per experiment)
// =============================================================================

Table workflowdefinition {
  id text [pk]
  experiment_id text [not null]
  name text [not null]
  executable text [not null]
  trigger workflow_trigger_type [not null]
  location text [not null]
  parameters jsonb
  run_param_name text
  run_param_value text
  run_as_user text
}

// =============================================================================
// Runs (per experiment)
// =============================================================================

Table run {
  id text [pk, note: 'MongoDB ObjectId']
  run_number integer [not null]
  experiment_id text [not null]
  start_time timestamptz
  end_time timestamptz

  indexes {
    (run_number, experiment_id) [unique]
    experiment_id
  }
}

// =============================================================================
// Run production data + file stats (1:1 with run)
// =============================================================================

Table run_production_data {
  run_id text [pk, note: '1:1 with run']
  experiment_id text [not null, note: 'Denormalized for RLS']
  n_events bigint
  n_damaged bigint
  n_dropped bigint
  start_timestamp timestamptz
  end_timestamp timestamptz
  file_count bigint [note: 'Merged from runfiles']
  file_size_bytes bigint [note: 'Merged from runfiles']
}

// =============================================================================
// Run <-> Detector junction
// =============================================================================

Table run_detector {
  run_id text [not null]
  detector_id text [not null]
  experiment_id text [not null, note: 'Denormalized for RLS']
  value text [not null]

  indexes {
    (run_id, detector_id) [pk]
  }
}

// =============================================================================
// Logbook entries
// =============================================================================

Table logbook {
  id text [pk]
  experiment_id text [not null]
  run_id text [note: 'Nullable - not all entries tied to a run']
  created_time timestamptz [not null]
  content text
  content_type elog_content_type [not null, default: 'TEXT']
  tags "text[]" [note: 'PostgreSQL array']
  author text [not null]
}

// =============================================================================
// Workflow executions (job runs)
// =============================================================================

Table workflow {
  id text [pk]
  experiment_id text [not null, note: 'Denormalized for RLS']
  run_id text [not null]
  def_id text [not null]
  user_id text [not null]
  status text [not null]
  submit_time timestamptz [not null]
  tool_id bigint
  log_file_path text
}

// =============================================================================
// Relationships
// =============================================================================

// Identity & access
Ref: pi.id > user.id
Ref: user_posix_group.user_id > user.id
Ref: user_posix_group.posix_group_name > posix_group.name
Ref: experiment.pi_id > pi.id
Ref: experiment.posix_group > posix_group.name

// Experiment auxiliary
Ref: experiment_slack_channel.experiment_id > experiment.experiment_id
Ref: experiment_analysis_queue.experiment_id > experiment.experiment_id

// Experiment children
Ref: questionnaire.experiment_id > experiment.experiment_id
Ref: workflowdefinition.experiment_id > experiment.experiment_id
Ref: run.experiment_id > experiment.experiment_id
Ref: logbook.experiment_id > experiment.experiment_id
Ref: workflow.experiment_id > experiment.experiment_id

// Run children
Ref: run_production_data.run_id - run.id
Ref: run_production_data.experiment_id > experiment.experiment_id
Ref: run_detector.run_id > run.id
Ref: run_detector.detector_id > detector.id
Ref: run_detector.experiment_id > experiment.experiment_id
Ref: logbook.run_id > run.id

// Workflow execution refs
Ref: workflow.run_id > run.id
Ref: workflow.def_id > workflowdefinition.id
Ref: workflow.user_id > user.id
